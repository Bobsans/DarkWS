{
  "name": "darkws",
  "version": "4.0.0",
  "description": "Dependency-free DarkWS client for browsers",
  "keywords": [
    "websocket",
    "realtime",
    "rpc",
    "typescript"
  ],
  "homepage": "https://github.com/Bobsans/DarkWS#readme",
  "bugs": {
    "url": "https://github.com/Bobsans/DarkWS/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Bobsans/DarkWS.git",
    "directory": "packages/darkws"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
